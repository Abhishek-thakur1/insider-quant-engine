# ─────────────────────────────────────────────────────────────────────────────
# Quant Engine Daily Schedule  (all times IST — TZ=Asia/Kolkata set in image)
#
# Format: minute hour day month weekday command
# ─────────────────────────────────────────────────────────────────────────────

# 8:45 AM Mon–Fri → Boot auth bridge, send Telegram login ping
45 8 * * 1-5 /usr/local/bin/lifecycle.sh start_auth >> /var/log/scheduler.log 2>&1

# 9:15 AM Mon–Fri → Boot quant_engine (market opens 9:15 AM IST)
15 9 * * 1-5 /usr/local/bin/lifecycle.sh start_engine >> /var/log/scheduler.log 2>&1

# 3:30 PM Mon–Fri → Stop engine + purge stale token
30 15 * * 1-5 /usr/local/bin/lifecycle.sh stop_engine >> /var/log/scheduler.log 2>&1
