# ── Auth bridge — 7:45 AM Mon–Fri
45 7 * * 1-5 /usr/local/bin/lifecycle.sh start_auth >> /var/log/scheduler.log 2>&1

# ── Market open message — 9:07 AM Mon–Fri
07 9 * * 1-5 /usr/local/bin/market_message.sh open >> /var/log/scheduler.log 2>&1

# ── Liveness Check - 9:10 AM Mon-Fri (Verifies token before boot)
10 9 * * 1-5 /usr/local/bin/liveness.sh >> /var/log/scheduler.log 2>&1

# ── Quant engine boot — 9:00 AM Mon–Fri
00 9 * * 1-5 /usr/local/bin/lifecycle.sh start_engine >> /var/log/scheduler.log 2>&1

# ── Market close message — 3:17 PM Mon–Fri
17 15 * * 1-5 /usr/local/bin/market_message.sh close >> /var/log/scheduler.log 2>&1

# ── Stop engine — 3:30 PM Mon–Fri
30 15 * * 1-5 /usr/local/bin/lifecycle.sh stop_engine >> /var/log/scheduler.log 2>&1

# ── Database Backup — 4:00 PM Mon-Fri
00 16 * * 1-5 /usr/local/bin/db_backup.sh >> /var/log/scheduler.log 2>&1

# ── EOD screener — 4:30 PM Mon-Fri (trading days only; writes tomorrow's watchlist)
30 16 * * 1-5 /usr/local/bin/lifecycle.sh run_screener >> /var/log/scheduler.log 2>&1

# ── Token purge — 5:15 PM Mon-Fri (after the screener; moved from 3:30 PM)
15 17 * * 1-5 /usr/local/bin/lifecycle.sh purge_token >> /var/log/scheduler.log 2>&1
